DATA_DIR=.data
MAX_UPLOAD_MB=50

# auto = OCR only when the text layer is missing or unusable
# always = OCR every page
# never = text layer only
OCR_MODE=auto
OCR_LANGUAGE=eng
OCR_DPI=200
OCR_PSM=3

MIN_TEXT_CHARS=40
MIN_ALNUM_RATIO=0.25
LOW_CONFIDENCE_THRESHOLD=0.60

# Set this on Windows if Tesseract is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

PREPROCESS_GRAYSCALE=true
PREPROCESS_AUTOCONTRAST=true
# PREPROCESS_THRESHOLD=160

REMOVE_FURNITURE=true
FURNITURE_MARGIN=72
FURNITURE_THRESHOLD=0.60

EXPAND_CONTRACTIONS=true
LOWERCASE_TEXT=false
LOG_LEVEL=INFO
